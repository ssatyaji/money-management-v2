// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum Role {
  ADMIN
  USER
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum TransactionSource {
  MANUAL
  OCR
  BANK_IMPORT
}

enum BudgetPeriod {
  WEEKLY
  MONTHLY
  YEARLY
}

enum ReminderFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum BankName {
  PERMATA
  JAGO
  SEABANK
  BCA
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ============================================================================
// MODELS
// ============================================================================

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  password        String
  name            String
  firstName       String   @default("")
  lastName        String   @default("")
  occupation      String?
  phoneNumber     String?
  monthlyIncome   Decimal? @db.Decimal(15, 2)
  financialGoal   String?
  role            Role     @default(USER)
  avatar          String?
  isEmailVerified Boolean  @default(false)
  refreshToken    String?
  startingBalance Decimal  @default(0) @db.Decimal(15, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  transactions          Transaction[]
  categories            Category[]
  budgets               Budget[]
  reminders             Reminder[]
  bankStatements        BankStatement[]
  pushSubscriptions     PushSubscription[]
  accounts              Account[]
  recurringTransactions RecurringTransaction[]
  savingGoals           SavingGoal[]
  debts                 Debt[]
  investmentAssets      InvestmentAsset[]
  alerts                Alert[]
  aiChatSessions        AiChatSession[]
  aiInsights            AiInsight[]

  @@map("users")
}

model Category {
  id        String          @id @default(uuid())
  name      String
  icon      String?
  color     String?
  type      TransactionType
  isDefault Boolean         @default(false)
  userId    String?
  user      User?           @relation(fields: [userId], references: [id])
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  transactions          Transaction[]
  budgets               Budget[]
  recurringTransactions RecurringTransaction[]

  @@unique([name, userId])
  @@map("categories")
}

model Transaction {
  id          String            @id @default(uuid())
  amount      Decimal           @db.Decimal(15, 2)
  type        TransactionType
  description String?
  note        String?
  date        DateTime
  receipt     String?
  source      TransactionSource @default(MANUAL)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accountId String?
  account   Account? @relation("SourceAccountTransactions", fields: [accountId], references: [id], onDelete: Cascade)

  destinationAccountId String?
  destinationAccount   Account? @relation("DestinationAccountTransactions", fields: [destinationAccountId], references: [id], onDelete: Cascade)

  bankStatementId String?
  bankStatement   BankStatement? @relation(fields: [bankStatementId], references: [id])

  savingGoalId String?
  savingGoal   SavingGoal? @relation(fields: [savingGoalId], references: [id], onDelete: SetNull)

  goalContribution GoalContribution?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
  @@index([userId, type])
  @@index([userId, categoryId])
  @@map("transactions")
}

model Budget {
  id        String       @id @default(uuid())
  amount    Decimal      @db.Decimal(15, 2)
  spent     Decimal      @default(0) @db.Decimal(15, 2)
  period    BudgetPeriod
  startDate DateTime
  endDate   DateTime
  alertAt   Int          @default(80)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, categoryId, startDate, endDate])
  @@index([userId, period])
  @@map("budgets")
}

model Reminder {
  id           String             @id @default(uuid())
  title        String
  description  String?
  amount       Decimal?           @db.Decimal(15, 2)
  dueDate      DateTime
  isRecurring  Boolean            @default(false)
  frequency    ReminderFrequency?
  isCompleted  Boolean            @default(false)
  notifyBefore Int                @default(1)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, dueDate])
  @@index([userId, isCompleted])
  @@map("reminders")
}

model BankStatement {
  id            String           @id @default(uuid())
  fileName      String
  filePath      String
  bankName      BankName
  statementDate DateTime?
  status        ProcessingStatus @default(PENDING)
  errorMessage  String?
  processedAt   DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@map("bank_statements")
}

model PushSubscription {
  id       String @id @default(uuid())
  endpoint String @unique
  p256dh   String
  auth     String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("push_subscriptions")
}

model Account {
  id              String   @id @default(uuid())
  name            String
  color           String?  @default("#3b82f6")
  startingBalance Decimal  @default(0) @db.Decimal(15, 2)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  transactions            Transaction[]          @relation("SourceAccountTransactions")
  destinationTransactions Transaction[]          @relation("DestinationAccountTransactions")
  recurringTransactions   RecurringTransaction[]
  goalContributions       GoalContribution[]

  @@unique([name, userId])
  @@map("accounts")
}

model OtpVerification {
  id        String   @id @default(uuid())
  email     String
  code      String
  purpose   String // "REGISTER" | "FORGOT_PASSWORD"
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email, code])
  @@map("otp_verifications")
}

enum RecurringFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

model RecurringTransaction {
  id            String             @id @default(uuid())
  amount        Decimal            @db.Decimal(15, 2)
  type          TransactionType
  description   String
  note          String?
  frequency     RecurringFrequency
  startDate     DateTime
  nextDueDate   DateTime
  isActive      Boolean            @default(true)
  lastTriggered DateTime?

  // Notification fields (merged from Reminders feature)
  notifyBeforeDays  Int?      // null = no notification; 1 = notify 1 day before due
  lastNotifiedDate  DateTime? // tracks last notification to prevent duplicates

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, nextDueDate])
  @@index([userId, isActive])
  @@map("recurring_transactions")
}

// ============================================================================
// SAVING GOALS (Wishlist)
// ============================================================================

enum GoalType {
  SAVE_UP // Kumpulkan uang (DP rumah, dana darurat)
  PAY_OFF // Lunasi hutang (cicilan mobil, KPR)
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model SavingGoal {
  id            String     @id @default(uuid())
  name          String
  description   String?
  icon          String?    @default("🎯")
  color         String?    @default("#6366f1")
  goalType      GoalType
  targetAmount  Decimal    @db.Decimal(15, 2)
  currentAmount Decimal    @default(0) @db.Decimal(15, 2)
  deadline      DateTime?
  monthlyTarget Decimal?   @db.Decimal(15, 2)
  status        GoalStatus @default(ACTIVE)
  completedAt   DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  contributions GoalContribution[]
  transactions  Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@map("saving_goals")
}

model GoalContribution {
  id     String   @id @default(uuid())
  amount Decimal  @db.Decimal(15, 2)
  note   String?
  date   DateTime @default(now())

  goalId String
  goal   SavingGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  transactionId String?      @unique
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([goalId, date])
  @@map("goal_contributions")
}

// ============================================================================
// DEBT TRACKING
// ============================================================================

enum DebtType {
  RECEIVABLE // Piutang — orang hutang ke kita
  PAYABLE // Hutang — kita hutang ke orang
}

enum DebtStatus {
  ACTIVE
  PARTIALLY_PAID
  SETTLED
  CANCELLED
}

model Debt {
  id            String     @id @default(uuid())
  personName    String
  personContact String?
  description   String?
  type          DebtType
  totalAmount   Decimal    @db.Decimal(15, 2)
  paidAmount    Decimal    @default(0) @db.Decimal(15, 2)
  status        DebtStatus @default(ACTIVE)
  dueDate       DateTime?
  borrowDate    DateTime   @default(now())
  settledAt     DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  payments DebtPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([userId, type])
  @@map("debts")
}

model DebtPayment {
  id     String   @id @default(uuid())
  amount Decimal  @db.Decimal(15, 2)
  note   String?
  date   DateTime @default(now())

  debtId String
  debt   Debt   @relation(fields: [debtId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([debtId, date])
  @@map("debt_payments")
}

// ============================================================================
// INVESTMENT PORTFOLIO
// ============================================================================

enum AssetType {
  STOCK // Saham
  GOLD // Emas
  CRYPTO // Cryptocurrency
  MUTUAL_FUND // Reksa Dana
  BOND // Obligasi
  DEPOSIT // Deposito
  PROPERTY // Properti
  OTHER // Lainnya
}

model InvestmentAsset {
  id        String    @id @default(uuid())
  name      String
  ticker    String?
  assetType AssetType
  icon      String?   @default("📈")
  color     String?   @default("#8b5cf6")

  totalUnits       Decimal  @db.Decimal(18, 8)
  avgBuyPrice      Decimal  @db.Decimal(15, 2)
  currentPrice     Decimal  @db.Decimal(15, 2)
  currentPriceDate DateTime @default(now())

  totalInvested Decimal @db.Decimal(15, 2)
  currentValue  Decimal @db.Decimal(15, 2)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions InvestmentTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name, assetType])
  @@index([userId, assetType])
  @@map("investment_assets")
}

model InvestmentTransaction {
  id           String   @id @default(uuid())
  type         String // "BUY" | "SELL" | "DIVIDEND"
  units        Decimal  @db.Decimal(18, 8)
  pricePerUnit Decimal  @db.Decimal(15, 2)
  totalAmount  Decimal  @db.Decimal(15, 2)
  fee          Decimal  @default(0) @db.Decimal(15, 2)
  note         String?
  date         DateTime @default(now())

  assetId String
  asset   InvestmentAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([assetId, date])
  @@map("investment_transactions")
}

model Alert {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String
  metadata  Json?
  isRead    Boolean  @default(false)
  severity  String
  createdAt DateTime @default(now())
  expiresAt DateTime
  @@index([userId, isRead])
  @@map("alerts")
}

model AiChatSession {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  context   String?
  contextId String?
  messages  AiChatMessage[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  @@map("ai_chat_sessions")
}

model AiChatMessage {
  id        String        @id @default(cuid())
  sessionId String
  session   AiChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String
  content   String
  createdAt DateTime      @default(now())
  @@map("ai_chat_messages")
}

model AiInsight {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  body        String
  actionLabel String?
  actionUrl   String?
  isRead      Boolean  @default(false)
  generatedAt DateTime @default(now())
  expiresAt   DateTime
  @@map("ai_insights")
}

